(module {surf_path: "Hello.Tests.Basics.Linearity"}
  hello.tests.basics.linearity
  (import {surf_path: "Hello.Basics.Linearity"}
    hello.basics.linearity
    (double_shared fan_out))
  (import {surf_path: "Std.Test"} std.test (assert_close_tensor))
  (defsig {} test_residual_doubles (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {}
    test_residual_doubles
    (fn {}
      (params {})
      (let {span: "surf:178..351"}
        (bind {}
          x
          (app {span: "surf:186..221"}
            (var {span: "surf:186..195"} to_tensor)
            (app {span: "surf:196..220"}
              (var {} Cons)
              (lit {span: "surf:197..203", surf_literal_style: "explicit", type: (t-prim {} f32)} 1.0)
              (app {}
                (var {} Cons)
                (lit {span: "surf:205..211", surf_literal_style: "explicit", type: (t-prim {} f32)} 2.0)
                (app {}
                  (var {} Cons)
                  (lit {span: "surf:213..219", surf_literal_style: "explicit", type: (t-prim {} f32)} 3.0)
                  (var {} Nil))))))
        (let {}
          (bind {}
            expected
            (app {span: "surf:235..270"}
              (var {span: "surf:235..244"} to_tensor)
              (app {span: "surf:245..269"}
                (var {} Cons)
                (lit {span: "surf:246..252", surf_literal_style: "explicit", type: (t-prim {} f32)} 2.0)
                (app {}
                  (var {} Cons)
                  (lit {span: "surf:254..260", surf_literal_style: "explicit", type: (t-prim {} f32)} 4.0)
                  (app {}
                    (var {} Cons)
                    (lit {span: "surf:262..268", surf_literal_style: "explicit", type: (t-prim {} f32)} 6.0)
                    (var {} Nil))))))
          (app {span: "surf:273..349"}
            (var {span: "surf:273..292"} assert_close_tensor)
            (app {span: "surf:293..309"}
              (var {span: "surf:293..306"} double_shared)
              (var {span: "surf:307..308"} x))
            (var {span: "surf:311..319"} expected)
            (lit {span: "surf:321..328", surf_literal_style: "explicit", type: (t-prim {} f32)} 0.000001)
            (lit {span: "surf:330..348", type: (t-prim {} string)} "residual_doubles"))))))
  (defsig {} test_fan_out_triples (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {}
    test_fan_out_triples
    (fn {}
      (params {})
      (let {span: "surf:400..545"}
        (bind {}
          x
          (app {span: "surf:408..435"}
            (var {span: "surf:408..417"} to_tensor)
            (app {span: "surf:418..434"}
              (var {} Cons)
              (lit {span: "surf:419..425", surf_literal_style: "explicit", type: (t-prim {} f32)} 1.0)
              (app {}
                (var {} Cons)
                (lit {span: "surf:427..433", surf_literal_style: "explicit", type: (t-prim {} f32)} 2.0)
                (var {} Nil)))))
        (let {}
          (bind {}
            expected
            (app {span: "surf:449..476"}
              (var {span: "surf:449..458"} to_tensor)
              (app {span: "surf:459..475"}
                (var {} Cons)
                (lit {span: "surf:460..466", surf_literal_style: "explicit", type: (t-prim {} f32)} 3.0)
                (app {}
                  (var {} Cons)
                  (lit {span: "surf:468..474", surf_literal_style: "explicit", type: (t-prim {} f32)} 6.0)
                  (var {} Nil)))))
          (app {span: "surf:479..543"}
            (var {span: "surf:479..498"} assert_close_tensor)
            (app {span: "surf:499..509"}
              (var {span: "surf:499..506"} fan_out)
              (var {span: "surf:507..508"} x))
            (var {span: "surf:511..519"} expected)
            (lit {span: "surf:521..528", surf_literal_style: "explicit", type: (t-prim {} f32)} 0.000001)
            (lit {span: "surf:530..542", type: (t-prim {} string)} "fan_out_3x")))))))
