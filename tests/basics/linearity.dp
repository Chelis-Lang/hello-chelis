(module {surf_path: "Hello.Tests.Basics.Linearity"}
  hello.tests.basics.linearity
  (import {surf_path: "Hello.Basics.Linearity"}
    hello.basics.linearity
    (double_shared fan_out))
  (import {surf_path: "Std.Test"} std.test (assert_close_tensor))
  (defsig {} test_residual_doubles (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {}
    test_residual_doubles
    (fn {}
      (params {})
      (let {span: "surf:178..407"}
        (bind {}
          x
          (app {span: "surf:186..245"}
            (var {span: "surf:186..195"} to_tensor)
            (app {span: "surf:196..244"}
              (var {} Cons)
              (cast {span: "surf:197..211"}
                (lit {span: "surf:202..205", surf_literal_style: "unsuffixed", type: (t-prim {} f32)} 1.0)
                (t-prim {} f32))
              (app {}
                (var {} Cons)
                (cast {span: "surf:213..227"}
                  (lit {span: "surf:218..221", surf_literal_style: "unsuffixed", type: (t-prim {} f32)} 2.0)
                  (t-prim {} f32))
                (app {}
                  (var {} Cons)
                  (cast {span: "surf:229..243"}
                    (lit {span: "surf:234..237", surf_literal_style: "unsuffixed", type: (t-prim {} f32)} 3.0)
                    (t-prim {} f32))
                  (var {} Nil))))))
        (let {}
          (bind {}
            expected
            (app {span: "surf:259..318"}
              (var {span: "surf:259..268"} to_tensor)
              (app {span: "surf:269..317"}
                (var {} Cons)
                (cast {span: "surf:270..284"}
                  (lit {span: "surf:275..278", surf_literal_style: "unsuffixed", type: (t-prim {} f32)} 2.0)
                  (t-prim {} f32))
                (app {}
                  (var {} Cons)
                  (cast {span: "surf:286..300"}
                    (lit {span: "surf:291..294", surf_literal_style: "unsuffixed", type: (t-prim {} f32)} 4.0)
                    (t-prim {} f32))
                  (app {}
                    (var {} Cons)
                    (cast {span: "surf:302..316"}
                      (lit {span: "surf:307..310", surf_literal_style: "unsuffixed", type: (t-prim {} f32)} 6.0)
                      (t-prim {} f32))
                    (var {} Nil))))))
          (app {span: "surf:321..405"}
            (var {span: "surf:321..340"} assert_close_tensor)
            (app {span: "surf:341..357"}
              (var {span: "surf:341..354"} double_shared)
              (var {span: "surf:355..356"} x))
            (var {span: "surf:359..367"} expected)
            (cast {span: "surf:369..384"}
              (lit {span: "surf:374..378", surf_literal_style: "unsuffixed", type: (t-prim {} f32)} 0.000001)
              (t-prim {} f32))
            (lit {span: "surf:386..404", type: (t-prim {} string)} "residual_doubles"))))))
  (defsig {} test_fan_out_triples (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {}
    test_fan_out_triples
    (fn {}
      (params {})
      (let {span: "surf:456..641"}
        (bind {}
          x
          (app {span: "surf:464..507"}
            (var {span: "surf:464..473"} to_tensor)
            (app {span: "surf:474..506"}
              (var {} Cons)
              (cast {span: "surf:475..489"}
                (lit {span: "surf:480..483", surf_literal_style: "unsuffixed", type: (t-prim {} f32)} 1.0)
                (t-prim {} f32))
              (app {}
                (var {} Cons)
                (cast {span: "surf:491..505"}
                  (lit {span: "surf:496..499", surf_literal_style: "unsuffixed", type: (t-prim {} f32)} 2.0)
                  (t-prim {} f32))
                (var {} Nil)))))
        (let {}
          (bind {}
            expected
            (app {span: "surf:521..564"}
              (var {span: "surf:521..530"} to_tensor)
              (app {span: "surf:531..563"}
                (var {} Cons)
                (cast {span: "surf:532..546"}
                  (lit {span: "surf:537..540", surf_literal_style: "unsuffixed", type: (t-prim {} f32)} 3.0)
                  (t-prim {} f32))
                (app {}
                  (var {} Cons)
                  (cast {span: "surf:548..562"}
                    (lit {span: "surf:553..556", surf_literal_style: "unsuffixed", type: (t-prim {} f32)} 6.0)
                    (t-prim {} f32))
                  (var {} Nil)))))
          (app {span: "surf:567..639"}
            (var {span: "surf:567..586"} assert_close_tensor)
            (app {span: "surf:587..597"}
              (var {span: "surf:587..594"} fan_out)
              (var {span: "surf:595..596"} x))
            (var {span: "surf:599..607"} expected)
            (cast {span: "surf:609..624"}
              (lit {span: "surf:614..618", surf_literal_style: "unsuffixed", type: (t-prim {} f32)} 0.000001)
              (t-prim {} f32))
            (lit {span: "surf:626..638", type: (t-prim {} string)} "fan_out_3x")))))))
