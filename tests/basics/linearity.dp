(module {}
  hello.tests.basics.linearity
  (import {} hello.basics.linearity (residual fan_out))
  (import {} std.test (assert_close_tensor))
  (defsig {}
    test_residual_doubles
    (t-fn {eff: (effects {} test)} (t-prim {} unit)))
  (def {}
    test_residual_doubles
    (fn {}
      (params {})
      (let {span: "surf:173..401"}
        (bind {span: "surf:173..401"}
          x
          (app {span: "surf:181..240"}
            (var {span: "surf:181..190"} to_tensor)
            (app {span: "surf:191..239"}
              (var {} Cons)
              (cast {span: "surf:192..206"}
                (lit {span: "surf:197..200", type: (t-prim {} f32)} 1.0)
                (t-prim {} f32))
              (app {}
                (var {} Cons)
                (cast {span: "surf:208..222"}
                  (lit {span: "surf:213..216", type: (t-prim {} f32)} 2.0)
                  (t-prim {} f32))
                (app {}
                  (var {} Cons)
                  (cast {span: "surf:224..238"}
                    (lit {span: "surf:229..232", type: (t-prim {} f32)} 3.0)
                    (t-prim {} f32))
                  (var {} Nil))))))
        (let {}
          (bind {}
            expected
            (app {span: "surf:254..313"}
              (var {span: "surf:254..263"} to_tensor)
              (app {span: "surf:264..312"}
                (var {} Cons)
                (cast {span: "surf:265..279"}
                  (lit {span: "surf:270..273", type: (t-prim {} f32)} 2.0)
                  (t-prim {} f32))
                (app {}
                  (var {} Cons)
                  (cast {span: "surf:281..295"}
                    (lit {span: "surf:286..289", type: (t-prim {} f32)} 4.0)
                    (t-prim {} f32))
                  (app {}
                    (var {} Cons)
                    (cast {span: "surf:297..311"}
                      (lit {span: "surf:302..305", type: (t-prim {} f32)} 6.0)
                      (t-prim {} f32))
                    (var {} Nil))))))
          (app {span: "surf:316..399"}
            (var {span: "surf:316..335"} assert_close_tensor)
            (app {source: (residual (var {span: "surf:345..346"} x))}
              (var {source: (residual (var {span: "surf:345..346"} x))} add)
              (var {source: (residual (var {span: "surf:345..346"} x)), span: "surf:345..346"} x)
              (app {source: (residual (var {span: "surf:345..346"} x))}
                (var {source: (residual (var {span: "surf:345..346"} x))} f)
                (var {source: (residual (var {span: "surf:345..346"} x)), span: "surf:345..346"} x)))
            (var {span: "surf:349..357"} expected)
            (cast {span: "surf:359..378"}
              (lit {span: "surf:364..372", type: (t-prim {} f32)} 0.000001)
              (t-prim {} f32))
            (lit {span: "surf:380..398", type: (t-prim {} string)} "residual_doubles"))))))
  (defsig {}
    test_fan_out_triples
    (t-fn {eff: (effects {} test)} (t-prim {} unit)))
  (def {}
    test_fan_out_triples
    (fn {}
      (params {})
      (let {span: "surf:450..639"}
        (bind {span: "surf:450..639"}
          x
          (app {span: "surf:458..501"}
            (var {span: "surf:458..467"} to_tensor)
            (app {span: "surf:468..500"}
              (var {} Cons)
              (cast {span: "surf:469..483"}
                (lit {span: "surf:474..477", type: (t-prim {} f32)} 1.0)
                (t-prim {} f32))
              (app {}
                (var {} Cons)
                (cast {span: "surf:485..499"}
                  (lit {span: "surf:490..493", type: (t-prim {} f32)} 2.0)
                  (t-prim {} f32))
                (var {} Nil)))))
        (let {}
          (bind {}
            expected
            (app {span: "surf:515..558"}
              (var {span: "surf:515..524"} to_tensor)
              (app {span: "surf:525..557"}
                (var {} Cons)
                (cast {span: "surf:526..540"}
                  (lit {span: "surf:531..534", type: (t-prim {} f32)} 3.0)
                  (t-prim {} f32))
                (app {}
                  (var {} Cons)
                  (cast {span: "surf:542..556"}
