            (var {span: "surf:593..601"} expected)
            (cast {span: "surf:603..622"}
              (lit {span: "surf:608..616", type: (t-prim {} f32)} 0.000001)
              (t-prim {} f32))
            (lit {span: "surf:624..636", type: (t-prim {} string)} "fan_out_3x")))))))
