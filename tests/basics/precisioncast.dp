  (import {surf_path: "Std.Test"} std.test (assert_close))
  (defsig {} test_round_15 (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {}
    test_round_15
    (fn {}
      (params {})
      (app {span: "surf:161..249"}
        (var {span: "surf:161..173"} assert_close)
        (app {span: "surf:174..202"}
          (var {span: "surf:174..186"} round_scalar)
          (cast {span: "surf:187..201"}
            (lit {span: "surf:192..195", surf_literal_style: "unsuffixed", type: (t-prim {} f32)} 1.5)
            (t-prim {} f32)))
        (cast {span: "surf:204..218"}
          (lit {span: "surf:209..212", surf_literal_style: "unsuffixed", type: (t-prim {} f32)} 1.5)
          (t-prim {} f32))
        (cast {span: "surf:220..235"}
          (lit {span: "surf:225..229", surf_literal_style: "unsuffixed", type: (t-prim {} f32)} 0.000000001)
          (t-prim {} f32))
        (lit {span: "surf:237..248", type: (t-prim {} string)} "round_1p5"))))
  (defsig {} test_round_pi (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {}
    test_round_pi
    (fn {}
      (params {})
      (app {span: "surf:291..386"}
        (var {span: "surf:291..303"} assert_close)
        (app {span: "surf:304..336"}
          (var {span: "surf:304..316"} round_scalar)
          (cast {span: "surf:317..335"}
