            (t-prim {} f32)))
        (cast {span: "surf:338..356"}
          (lit {span: "surf:343..350", surf_literal_style: "unsuffixed", type: (t-prim {} f32)} 3.14159)
          (t-prim {} f32))
        (cast {span: "surf:358..373"}
          (lit {span: "surf:363..367", surf_literal_style: "unsuffixed", type: (t-prim {} f32)} 0.000001)
          (t-prim {} f32))
        (lit {span: "surf:375..385", type: (t-prim {} string)} "round_pi")))))
