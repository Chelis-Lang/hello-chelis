  (defsig {span: "surf:564..772"}
    test_outer_join_union
    (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {span: "surf:564..772"}
    test_outer_join_union
    (fn {}
      (params {})
      (let {span: "surf:613..772"}
        (bind {}
          r
          (app {span: "surf:621..628"} (var {span: "surf:621..626"} outer)))
        (let {}
          (bind {destructure: true}
            __chelis_tmp2
            (app {span: "surf:635..699"}
              (var {span: "surf:635..644"} assert_eq)
              (app {span: "surf:645..653"}
