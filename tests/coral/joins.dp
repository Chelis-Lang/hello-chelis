                (t-prim {} i64))
              (lit {span: "surf:497..530", type: (t-prim {} string)} "left join keeps all 3 left rows")))
          (app {span: "surf:534..613"}
            (var {span: "surf:534..547"} assert_eq_int)
            (app {span: "surf:548..556"}
