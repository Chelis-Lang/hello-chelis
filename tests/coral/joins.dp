(module {surf_path: "Hello.Tests.Coral.Joins"}
  hello.tests.coral.joins
  (import {surf_path: "Hello.Coral.Joins"} hello.coral.joins (inner left outer))
  (import {surf_path: "Coral.Frame"} coral.frame (nrows ncols))
  (import {surf_path: "Std.Test"} std.test (assert_eq_int))
  (defsig {}
    test_inner_join_intersection
    (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {}
    test_inner_join_intersection
    (fn {}
      (params {})
      (let {span: "surf:199..379"}
        (bind {}
          r
          (app {span: "surf:207..214"} (var {span: "surf:207..212"} inner)))
        (let {}
          (bind {destructure: true}
            __chelis_tmp0
            (app {span: "surf:221..294"}
              (var {span: "surf:221..234"} assert_eq_int)
              (app {span: "surf:235..243"}
                (var {span: "surf:235..240"} nrows)
                (var {span: "surf:241..242"} r))
              (cast {span: "surf:245..257"}
                (lit {span: "surf:250..251", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 2)
                (t-prim {} i64))
              (lit {span: "surf:259..293", type: (t-prim {} string)} "inner join keeps 2 matching rows")))
          (app {span: "surf:297..377"}
            (var {span: "surf:297..310"} assert_eq_int)
            (app {span: "surf:311..319"}
              (var {span: "surf:311..316"} ncols)
              (var {span: "surf:317..318"} r))
            (cast {span: "surf:321..333"}
              (lit {span: "surf:326..327", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 3)
              (t-prim {} i64))
            (lit {span: "surf:335..376", type: (t-prim {} string)} "inner join: customer + qty + score == 3"))))))
  (defsig {}
    test_left_join_keeps_left_side
