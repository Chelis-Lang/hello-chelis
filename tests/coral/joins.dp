            (app {span: "surf:459..531"}
              (var {span: "surf:459..472"} assert_eq_int)
              (app {span: "surf:473..481"}
                (var {span: "surf:473..478"} nrows)
                (var {span: "surf:479..480"} r))
              (cast {span: "surf:483..495"}
