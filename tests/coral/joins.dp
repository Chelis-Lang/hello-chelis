(module {surf_path: "Hello.Tests.Coral.Joins"}
  hello.tests.coral.joins
  (import {surf_path: "Hello.Coral.Joins"} hello.coral.joins (inner left outer))
  (import {surf_path: "Coral.Frame"} coral.frame (nrows ncols))
  (import {surf_path: "Std.Test"} std.test (assert_eq))
  (defsig {span: "surf:139..351"}
    test_inner_join_intersection
    (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {span: "surf:139..351"}
    test_inner_join_intersection
    (fn {}
      (params {})
      (let {span: "surf:195..351"}
        (bind {}
          r
          (app {span: "surf:203..210"} (var {span: "surf:203..208"} inner)))
        (let {}
          (bind {destructure: true}
            __chelis_tmp0
            (app {span: "surf:217..278"}
              (var {span: "surf:217..226"} assert_eq)
              (app {span: "surf:227..235"}
                (var {span: "surf:227..232"} nrows)
                (var {span: "surf:233..234"} r))
              (lit {span: "surf:237..241", type: (t-prim {} i64)} 2)
              (lit {span: "surf:243..277", type: (t-prim {} string)} "inner join keeps 2 matching rows")))
          (app {span: "surf:281..349"}
            (var {span: "surf:281..290"} assert_eq)
            (app {span: "surf:291..299"}
              (var {span: "surf:291..296"} ncols)
              (var {span: "surf:297..298"} r))
            (lit {span: "surf:301..305", type: (t-prim {} i64)} 3)
            (lit {span: "surf:307..348", type: (t-prim {} string)} "inner join: customer + qty + score == 3"))))))
  (defsig {span: "surf:352..563"}
