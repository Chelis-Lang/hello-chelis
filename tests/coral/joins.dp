          r
          (app {span: "surf:434..440"} (var {span: "surf:434..438"} left)))
        (let {}
          (bind {destructure: true}
            __chelis_tmp1
            (app {span: "surf:447..515"}
              (var {span: "surf:447..456"} assert_eq)
              (app {span: "surf:457..465"}
                (var {span: "surf:457..462"} nrows)
                (var {span: "surf:463..464"} r))
              (cast {span: "surf:467..479"}
                (lit {span: "surf:472..473", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 3)
                (t-prim {} i64))
              (lit {span: "surf:481..514", type: (t-prim {} string)} "left join keeps all 3 left rows")))
          (app {span: "surf:518..593"}
            (var {span: "surf:518..527"} assert_eq)
            (app {span: "surf:528..536"}
              (var {span: "surf:528..533"} ncols)
