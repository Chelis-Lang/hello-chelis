              (lit {span: "surf:451..455", type: (t-prim {} i64)} 3)
              (lit {span: "surf:457..490", type: (t-prim {} string)} "left join keeps all 3 left rows")))
          (app {span: "surf:494..561"}
            (var {span: "surf:494..503"} assert_eq)
            (app {span: "surf:504..512"}
              (var {span: "surf:504..509"} ncols)
