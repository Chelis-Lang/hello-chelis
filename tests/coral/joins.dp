  (defsig {} test_outer_join_union (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {}
    test_outer_join_union
    (fn {}
      (params {})
      (let {span: "surf:665..848"}
        (bind {}
          r
          (app {span: "surf:673..680"} (var {span: "surf:673..678"} outer)))
        (let {}
          (bind {destructure: true}
            __chelis_tmp2
            (app {span: "surf:687..763"}
              (var {span: "surf:687..700"} assert_eq_int)
              (app {span: "surf:701..709"}
                (var {span: "surf:701..706"} nrows)
                (var {span: "surf:707..708"} r))
              (cast {span: "surf:711..723"}
