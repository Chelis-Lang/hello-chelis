(module {surf_path: "Hello.Tests.Coral.Joins"}
  hello.tests.coral.joins
  (import {surf_path: "Hello.Coral.Joins"} hello.coral.joins (inner left outer))
  (import {surf_path: "Coral.Frame"} coral.frame (nrows ncols))
  (import {surf_path: "Std.Test"} std.test (assert_eq))
  (defsig {}
    test_inner_join_intersection
    (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {}
    test_inner_join_intersection
    (fn {}
      (params {})
      (let {span: "surf:195..367"}
        (bind {}
          r
          (app {span: "surf:203..210"} (var {span: "surf:203..208"} inner)))
        (let {}
          (bind {destructure: true}
            __chelis_tmp0
            (app {span: "surf:217..286"}
              (var {span: "surf:217..226"} assert_eq)
              (app {span: "surf:227..235"}
                (var {span: "surf:227..232"} nrows)
                (var {span: "surf:233..234"} r))
              (cast {span: "surf:237..249"}
                (lit {span: "surf:242..243", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 2)
                (t-prim {} i64))
              (lit {span: "surf:251..285", type: (t-prim {} string)} "inner join keeps 2 matching rows")))
          (app {span: "surf:289..365"}
            (var {span: "surf:289..298"} assert_eq)
            (app {span: "surf:299..307"}
              (var {span: "surf:299..304"} ncols)
              (var {span: "surf:305..306"} r))
            (cast {span: "surf:309..321"}
              (lit {span: "surf:314..315", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 3)
              (t-prim {} i64))
            (lit {span: "surf:323..364", type: (t-prim {} string)} "inner join: customer + qty + score == 3"))))))
  (defsig {}
    test_left_join_keeps_left_side
    (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {}
    test_left_join_keeps_left_side
    (fn {}
      (params {})
      (let {span: "surf:426..595"}
