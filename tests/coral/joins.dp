              (t-prim {} i64))
            (lit {span: "surf:552..592", type: (t-prim {} string)} "left join: customer + qty + score == 3"))))))
  (defsig {} test_outer_join_union (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {}
    test_outer_join_union
    (fn {}
      (params {})
      (let {span: "surf:645..820"}
        (bind {}
          r
          (app {span: "surf:653..660"} (var {span: "surf:653..658"} outer)))
        (let {}
          (bind {destructure: true}
            __chelis_tmp2
            (app {span: "surf:667..739"}
              (var {span: "surf:667..676"} assert_eq)
              (app {span: "surf:677..685"}
                (var {span: "surf:677..682"} nrows)
                (var {span: "surf:683..684"} r))
              (cast {span: "surf:687..699"}
                (lit {span: "surf:692..693", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 4)
                (t-prim {} i64))
              (lit {span: "surf:701..738", type: (t-prim {} string)} "outer join produces union of 4 rows")))
          (app {span: "surf:742..818"}
            (var {span: "surf:742..751"} assert_eq)
            (app {span: "surf:752..760"}
              (var {span: "surf:752..757"} ncols)
