            (t-prim {} int64))
          (lit {span: "surf:434..452", type: (t-prim {} string)} "frame nrows == 3")))))
  (defsig {}
    test_simple_loss_value
    (t-fn {eff: (effects {} test)} (t-prim {} unit)))
  (def {}
    test_simple_loss_value
    (fn {}
      (params {})
      (let {span: "surf:506..717"}
        (bind {span: "surf:506..717"}
          w
          (app {span: "surf:514..573"}
            (var {span: "surf:514..523"} to_tensor)
            (app {span: "surf:524..572"}
              (var {} Cons)
              (cast {span: "surf:525..539"}
                (lit {span: "surf:530..533", type: (t-prim {} f32)} 1.0)
                (t-prim {} f32))
              (app {}
                (var {} Cons)
