                  (lit {span: "surf:546..549", type: (t-prim {} f32)} 2.0)
                  (t-prim {} f32))
                (app {}
                  (var {} Cons)
                  (cast {span: "surf:557..571"}
                    (lit {span: "surf:562..565", type: (t-prim {} f32)} 3.0)
                    (t-prim {} f32))
                  (var {} Nil))))))
        (let {}
          (bind {}
            expected
            (app {span: "surf:587..615"}
              (var {span: "surf:587..596"} to_tensor)
              (app {span: "surf:597..614"}
                (var {} Cons)
