        (var {span: "surf:247..248"} s)
        (lit {span: "surf:250..251", type: (t-prim {} int32)} 0)
        (lit {span: "surf:253..254", type: (t-prim {} int32)} 1))))
  (defsig {}
    test_frame_shape_from_tensor
    (t-fn {eff: (effects {} test)} (t-prim {} unit)))
  (def {}
    test_frame_shape_from_tensor
    (fn {}
      (params {})
      (let {span: "surf:312..455"}
        (bind {span: "surf:312..455"}
          w
          (app {span: "surf:320..379"}
            (var {span: "surf:320..329"} to_tensor)
            (app {span: "surf:330..378"}
              (var {} Cons)
              (cast {span: "surf:331..345"}
                (lit {span: "surf:336..339", type: (t-prim {} f32)} 1.0)
