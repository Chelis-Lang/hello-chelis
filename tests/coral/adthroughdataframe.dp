  (import {} std.test (assert_eq_int assert_close_tensor))
  (defsig {}
    reshape_to_one
    (t-fn {}
      (t-tensor {} (t-prim {} f32))
      (t-tensor {} (d-lit {} 1) (t-prim {} f32))))
  (def {}
    reshape_to_one
    (fn {}
      (params {} (s {type: (t-tensor {} (t-prim {} f32))}))
      (app {span: "surf:240..255"}
