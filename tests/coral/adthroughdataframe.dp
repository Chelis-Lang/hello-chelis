                (var {span: "surf:665..666"} w)))
            (var {span: "surf:670..678"} expected)
            (cast {span: "surf:680..698"}
              (lit {span: "surf:685..692", type: (t-prim {} f32)} 0.00001)
              (t-prim {} f32))
            (lit {span: "surf:700..714", type: (t-prim {} string)} "loss == 14.0"))))))
