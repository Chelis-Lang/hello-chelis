(module {surf_path: "Hello.Tests.Coral.Reshape"}
  hello.tests.coral.reshape
  (import {surf_path: "Hello.Coral.Reshape"}
    hello.coral.reshape
    (pivoted melted))
  (import {surf_path: "Coral.Frame"} coral.frame (nrows ncols))
  (import {surf_path: "Std.Test"} std.test (assert_eq))
  (defsig {span: "surf:140..324"}
    test_pivot_shape
    (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {span: "surf:140..324"}
    test_pivot_shape
    (fn {}
      (params {})
      (let {span: "surf:184..324"}
        (bind {}
          p
          (app {span: "surf:192..201"} (var {span: "surf:192..199"} pivoted)))
        (let {}
          (bind {destructure: true}
            __chelis_tmp0
            (app {span: "surf:208..261"}
              (var {span: "surf:208..217"} assert_eq)
              (app {span: "surf:218..226"}
                (var {span: "surf:218..223"} nrows)
                (var {span: "surf:224..225"} p))
              (lit {span: "surf:228..232", type: (t-prim {} i64)} 2)
              (lit {span: "surf:234..260", type: (t-prim {} string)} "pivot: 2 distinct cities")))
          (app {span: "surf:264..322"}
            (var {span: "surf:264..273"} assert_eq)
            (app {span: "surf:274..282"}
              (var {span: "surf:274..279"} ncols)
              (var {span: "surf:280..281"} p))
            (lit {span: "surf:284..288", type: (t-prim {} i64)} 3)
            (lit {span: "surf:290..321", type: (t-prim {} string)} "pivot: city + x + y == 3 cols"))))))
  (defsig {span: "surf:325..525"}
    test_melt_shape
    (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {span: "surf:325..525"}
    test_melt_shape
    (fn {}
      (params {})
      (let {span: "surf:368..525"}
        (bind {}
          m
          (app {span: "surf:376..384"} (var {span: "surf:376..382"} melted)))
        (let {}
          (bind {destructure: true}
            __chelis_tmp1
            (app {span: "surf:391..452"}
              (var {span: "surf:391..400"} assert_eq)
              (app {span: "surf:401..409"}
                (var {span: "surf:401..406"} nrows)
                (var {span: "surf:407..408"} m))
              (lit {span: "surf:411..415", type: (t-prim {} i64)} 6)
              (lit {span: "surf:417..451", type: (t-prim {} string)} "melt: 3 rows * 2 value cols == 6")))
          (app {span: "surf:455..523"}
            (var {span: "surf:455..464"} assert_eq)
            (app {span: "surf:465..473"}
              (var {span: "surf:465..470"} ncols)
              (var {span: "surf:471..472"} m))
            (lit {span: "surf:475..479", type: (t-prim {} i64)} 3)
            (lit {span: "surf:481..522", type: (t-prim {} string)} "melt: city + variable + value == 3 cols")))))))
