(module {surf_path: "Hello.Tests.Coral.Reshape"}
  hello.tests.coral.reshape
  (import {surf_path: "Hello.Coral.Reshape"}
    hello.coral.reshape
    (pivoted melted))
  (import {surf_path: "Coral.Frame"} coral.frame (nrows ncols))
  (import {surf_path: "Std.Test"} std.test (assert_eq_int))
  (defsig {} test_pivot_shape (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {}
    test_pivot_shape
    (fn {}
      (params {})
      (let {span: "surf:188..352"}
        (bind {}
          p
          (app {span: "surf:196..205"} (var {span: "surf:196..203"} pivoted)))
        (let {}
          (bind {destructure: true}
            __chelis_tmp0
            (app {span: "surf:212..277"}
              (var {span: "surf:212..225"} assert_eq_int)
              (app {span: "surf:226..234"}
                (var {span: "surf:226..231"} nrows)
                (var {span: "surf:232..233"} p))
              (cast {span: "surf:236..248"}
                (lit {span: "surf:241..242", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 2)
                (t-prim {} i64))
              (lit {span: "surf:250..276", type: (t-prim {} string)} "pivot: 2 distinct cities")))
          (app {span: "surf:280..350"}
            (var {span: "surf:280..293"} assert_eq_int)
            (app {span: "surf:294..302"}
              (var {span: "surf:294..299"} ncols)
              (var {span: "surf:300..301"} p))
            (cast {span: "surf:304..316"}
              (lit {span: "surf:309..310", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 3)
              (t-prim {} i64))
            (lit {span: "surf:318..349", type: (t-prim {} string)} "pivot: city + x + y == 3 cols"))))))
  (defsig {} test_melt_shape (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {}
    test_melt_shape
    (fn {}
      (params {})
      (let {span: "surf:396..577"}
        (bind {}
          m
          (app {span: "surf:404..412"} (var {span: "surf:404..410"} melted)))
        (let {}
          (bind {destructure: true}
            __chelis_tmp1
            (app {span: "surf:419..492"}
              (var {span: "surf:419..432"} assert_eq_int)
              (app {span: "surf:433..441"}
                (var {span: "surf:433..438"} nrows)
                (var {span: "surf:439..440"} m))
              (cast {span: "surf:443..455"}
                (lit {span: "surf:448..449", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 6)
                (t-prim {} i64))
              (lit {span: "surf:457..491", type: (t-prim {} string)} "melt: 3 rows * 2 value cols == 6")))
          (app {span: "surf:495..575"}
            (var {span: "surf:495..508"} assert_eq_int)
            (app {span: "surf:509..517"}
              (var {span: "surf:509..514"} ncols)
              (var {span: "surf:515..516"} m))
            (cast {span: "surf:519..531"}
              (lit {span: "surf:524..525", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 3)
              (t-prim {} i64))
            (lit {span: "surf:533..574", type: (t-prim {} string)} "melt: city + variable + value == 3 cols")))))))
