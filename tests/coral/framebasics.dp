(module {surf_path: "Hello.Tests.Coral.FrameBasics"}
  hello.tests.coral.framebasics
  (import {surf_path: "Hello.Coral.FrameBasics"}
    hello.coral.framebasics
    (build_frame add_score_col frame_after_rename frame_after_drop))
  (import {surf_path: "Coral.Frame"} coral.frame (nrows ncols columns))
  (import {surf_path: "Std.Test"}
    std.test
    (assert_eq_int assert_eq_string assert_true))
  (defsig {} test_build_frame_shape (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {}
    test_build_frame_shape
    (fn {}
      (params {})
      (let {span: "surf:291..453"}
        (bind {}
          df
          (app {span: "surf:300..313"}
            (var {span: "surf:300..311"} build_frame)))
        (let {}
          (bind {destructure: true}
            __chelis_tmp0
            (app {span: "surf:320..384"}
              (var {span: "surf:320..333"} assert_eq_int)
              (app {span: "surf:334..343"}
                (var {span: "surf:334..339"} nrows)
                (var {span: "surf:340..342"} df))
              (cast {span: "surf:345..357"}
                (lit {span: "surf:350..351", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 3)
                (t-prim {} i64))
              (lit {span: "surf:359..383", type: (t-prim {} string)} "build_frame nrows == 3")))
          (app {span: "surf:387..451"}
            (var {span: "surf:387..400"} assert_eq_int)
            (app {span: "surf:401..410"}
              (var {span: "surf:401..406"} ncols)
              (var {span: "surf:407..409"} df))
            (cast {span: "surf:412..424"}
              (lit {span: "surf:417..418", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 3)
              (t-prim {} i64))
            (lit {span: "surf:426..450", type: (t-prim {} string)} "build_frame ncols == 3"))))))
  (defsig {}
    test_with_column_grows_ncols
    (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {}
    test_with_column_grows_ncols
    (fn {}
      (params {})
      (let {span: "surf:510..705"}
        (bind {}
          df2
          (app {span: "surf:520..548"}
            (var {span: "surf:520..533"} add_score_col)
            (app {span: "surf:534..547"}
              (var {span: "surf:534..545"} build_frame))))
        (let {}
          (bind {destructure: true}
            __chelis_tmp1
            (app {span: "surf:555..629"}
              (var {span: "surf:555..568"} assert_eq_int)
              (app {span: "surf:569..579"}
                (var {span: "surf:569..574"} nrows)
                (var {span: "surf:575..578"} df2))
              (cast {span: "surf:581..593"}
                (lit {span: "surf:586..587", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 3)
                (t-prim {} i64))
              (lit {span: "surf:595..628", type: (t-prim {} string)} "after with_column nrows still 3")))
          (app {span: "surf:632..703"}
            (var {span: "surf:632..645"} assert_eq_int)
            (app {span: "surf:646..656"}
              (var {span: "surf:646..651"} ncols)
              (var {span: "surf:652..655"} df2))
            (cast {span: "surf:658..670"}
              (lit {span: "surf:663..664", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 4)
              (t-prim {} i64))
            (lit {span: "surf:672..702", type: (t-prim {} string)} "after with_column ncols == 4"))))))
  (defsig {} test_rename_and_drop (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {}
    test_rename_and_drop
    (fn {}
      (params {})
      (let {span: "surf:754..1172"}
        (bind {}
          renamed
          (app {span: "surf:768..801"}
            (var {span: "surf:768..786"} frame_after_rename)
            (app {span: "surf:787..800"}
              (var {span: "surf:787..798"} build_frame))))
        (let {}
          (bind {}
            dropped
            (app {span: "surf:814..845"}
              (var {span: "surf:814..830"} frame_after_drop)
              (app {span: "surf:831..844"}
                (var {span: "surf:831..842"} build_frame))))
          (let {}
            (bind {}
              names_r
              (app {span: "surf:858..874"}
                (var {span: "surf:858..865"} columns)
                (var {span: "surf:866..873"} renamed)))
            (let {}
              (bind {}
                has_town
                (app {span: "surf:888..961"}
                  (var {span: "surf:888..892"} fold)
                  (fn {span: "surf:893..944"}
                    (params {}
                      (acc {type: (t-prim {} bool)})
                      (n {type: (t-prim {} string)}))
                    (app {span: "surf:922..944"}
                      (var {span: "surf:922..924"} or)
                      (var {span: "surf:925..928"} acc)
                      (app {span: "surf:930..943"}
                        (var {span: "surf:930..932"} eq)
                        (var {span: "surf:933..934"} n)
                        (lit {span: "surf:936..942", type: (t-prim {} string)} "town"))))
                  (lit {span: "surf:946..951", type: (t-prim {} bool)} false)
                  (var {span: "surf:953..960"} names_r)))
              (let {}
                (bind {destructure: true}
                  __chelis_tmp3
                  (app {span: "surf:968..1022"}
                    (var {span: "surf:968..979"} assert_true)
                    (var {span: "surf:980..988"} has_town)
                    (lit {span: "surf:990..1021", type: (t-prim {} string)} "renamed frame contains 'town'")))
                (let {}
                  (bind {destructure: true}
                    __chelis_tmp2
                    (app {span: "surf:1029..1095"}
                      (var {span: "surf:1029..1042"} assert_eq_int)
                      (app {span: "surf:1043..1057"}
                        (var {span: "surf:1043..1048"} ncols)
                        (var {span: "surf:1049..1056"} renamed))
                      (cast {span: "surf:1059..1071"}
                        (lit {span: "surf:1064..1065", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 3)
                        (t-prim {} i64))
                      (lit {span: "surf:1073..1094", type: (t-prim {} string)} "rename keeps 3 cols")))
                  (app {span: "surf:1098..1170"}
                    (var {span: "surf:1098..1111"} assert_eq_int)
                    (app {span: "surf:1112..1126"}
                      (var {span: "surf:1112..1117"} ncols)
                      (var {span: "surf:1118..1125"} dropped))
                    (cast {span: "surf:1128..1140"}
                      (lit {span: "surf:1133..1134", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 2)
                      (t-prim {} i64))
                    (lit {span: "surf:1142..1169", type: (t-prim {} string)} "drop_column qty -> 2 cols")))))))))))
