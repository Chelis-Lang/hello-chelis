(module {surf_path: "Hello.Tests.Capstone.YieldCurve"}
  hello.tests.capstone.yieldcurve
  (import {surf_path: "Hello.Capstone.YieldCurve"}
    hello.capstone.yieldcurve
    (par_curve gapped_curve bond_price zero_rate dv01 key_rate_sensitivity))
  (import {surf_path: "Std.Test"} std.test (assert_close))
  (defsig {}
    test_bond_at_its_par_coupon_prices_at_par
    (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {}
    test_bond_at_its_par_coupon_prices_at_par
    (fn {}
      (params {})
      (app {span: "surf:249..392"}
        (var {span: "surf:249..261"} assert_close)
        (app {span: "surf:262..303"}
          (var {span: "surf:262..272"} bond_price)
          (app {span: "surf:273..284"} (var {span: "surf:273..282"} par_curve))
          (cast {span: "surf:286..302"}
            (lit {span: "surf:291..296", surf_literal_style: "unsuffixed", type: (t-prim {} f32)} 0.036)
            (t-prim {} f32)))
        (cast {span: "surf:305..319"}
          (lit {span: "surf:310..313", surf_literal_style: "unsuffixed", type: (t-prim {} f32)} 1.0)
          (t-prim {} f32))
        (cast {span: "surf:321..339"}
          (lit {span: "surf:326..333", surf_literal_style: "unsuffixed", type: (t-prim {} f32)} 0.00001)
          (t-prim {} f32))
        (lit {span: "surf:341..391", type: (t-prim {} string)} "a par-coupon bond on its own curve is worth face"))))
