(module {surf_path: "Hello.Tests.Capstone.YieldCurve"}
  hello.tests.capstone.yieldcurve
  (import {surf_path: "Hello.Capstone.YieldCurve"}
    hello.capstone.yieldcurve
    (par_curve gapped_curve bond_price zero_rate dv01 key_rate_sensitivity))
  (import {surf_path: "Std.Test"} std.test (assert_close))
  (defsig {}
    test_bond_at_its_par_coupon_prices_at_par
    (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {}
    test_bond_at_its_par_coupon_prices_at_par
    (fn {}
      (params {})
      (app {span: "surf:344..463"}
        (var {span: "surf:344..356"} assert_close)
        (app {span: "surf:357..390"}
          (var {span: "surf:357..367"} bond_price)
          (app {span: "surf:368..379"} (var {span: "surf:368..377"} par_curve))
          (lit {span: "surf:381..389", surf_literal_style: "explicit", type: (t-prim {} f32)} 0.036))
        (lit {span: "surf:392..398", surf_literal_style: "explicit", type: (t-prim {} f32)} 1.0)
        (lit {span: "surf:400..410", surf_literal_style: "explicit", type: (t-prim {} f32)} 0.00001)
        (lit {span: "surf:412..462", type: (t-prim {} string)} "a par-coupon bond on its own curve is worth face"))))
  (defsig {} test_zero_rate_5y (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {}
    test_zero_rate_5y
    (fn {}
      (params {})
      (app {span: "surf:509..601"}
        (var {span: "surf:509..521"} assert_close)
        (app {span: "surf:522..552"}
          (var {span: "surf:522..531"} zero_rate)
          (app {span: "surf:532..543"} (var {span: "surf:532..541"} par_curve))
          (lit {span: "surf:545..551", surf_literal_style: "explicit", type: (t-prim {} f32)} 5.0))
        (lit {span: "surf:554..566", surf_literal_style: "explicit", type: (t-prim {} f32)} 0.0355391)
        (lit {span: "surf:568..578", surf_literal_style: "explicit", type: (t-prim {} f32)} 0.00001)
        (lit {span: "surf:580..600", type: (t-prim {} string)} "5y continuous zero"))))
  (defsig {} test_premium_bond (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {}
    test_premium_bond
    (fn {}
      (params {})
      (app {span: "surf:647..775"}
        (var {span: "surf:647..659"} assert_close)
        (app {span: "surf:660..692"}
          (var {span: "surf:660..670"} bond_price)
          (app {span: "surf:671..682"} (var {span: "surf:671..680"} par_curve))
          (lit {span: "surf:684..691", surf_literal_style: "explicit", type: (t-prim {} f32)} 0.04))
        (lit {span: "surf:694..705", surf_literal_style: "explicit", type: (t-prim {} f32)} 1.018089)
        (lit {span: "surf:707..717", surf_literal_style: "explicit", type: (t-prim {} f32)} 0.00001)
        (lit {span: "surf:719..774", type: (t-prim {} string)} "a 4% coupon above the 3.6% par yield prices above par"))))
  (defsig {} test_dv01 (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {}
    test_dv01
    (fn {}
      (params {})
      (app {span: "surf:813..909"}
        (var {span: "surf:813..825"} assert_close)
        (app {span: "surf:826..839"}
          (var {span: "surf:826..830"} dv01)
          (lit {span: "surf:831..838", surf_literal_style: "explicit", type: (t-prim {} f32)} 0.04))
        (app {span: "surf:841..855"}
          (var {} neg)
          (lit {span: "surf:842..855", surf_literal_style: "explicit", type: (t-prim {} f32)} 0.00047141))
        (lit {span: "surf:857..864", surf_literal_style: "explicit", type: (t-prim {} f32)} 0.000002)
        (lit {span: "surf:866..908", type: (t-prim {} string)} "+1bp parallel loses about 4.7bp of price"))))
  (defsig {} test_key_rate_5y (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {}
    test_key_rate_5y
    (fn {}
      (params {})
      (app {span: "surf:954..1070"}
        (var {span: "surf:954..966"} assert_close)
        (app {span: "surf:967..1002"}
          (var {span: "surf:967..987"} key_rate_sensitivity)
          (lit {span: "surf:988..992", type: (t-prim {} i64)} 4)
          (lit {span: "surf:994..1001", surf_literal_style: "explicit", type: (t-prim {} f32)} 0.04))
        (app {span: "surf:1004..1018"}
          (var {} neg)
          (lit {span: "surf:1005..1018", surf_literal_style: "explicit", type: (t-prim {} f32)} 0.00043523))
        (lit {span: "surf:1020..1027", surf_literal_style: "explicit", type: (t-prim {} f32)} 0.000002)
        (lit {span: "surf:1029..1069", type: (t-prim {} string)} "the 5y pillar carries most of the risk"))))
  (defsig {}
    test_gapped_pillars_give_a_wrong_curve
    (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {}
    test_gapped_pillars_give_a_wrong_curve
    (fn {}
      (params {})
      (app {span: "surf:1229..1343"}
        (var {span: "surf:1229..1241"} assert_close)
        (app {span: "surf:1242..1275"}
          (var {span: "surf:1242..1251"} zero_rate)
          (app {span: "surf:1252..1266"}
            (var {span: "surf:1252..1264"} gapped_curve))
          (lit {span: "surf:1268..1274", surf_literal_style: "explicit", type: (t-prim {} f32)} 5.0))
        (lit {span: "surf:1277..1289", surf_literal_style: "explicit", type: (t-prim {} f32)} 0.0284362)
        (lit {span: "surf:1291..1301", surf_literal_style: "explicit", type: (t-prim {} f32)} 0.00001)
        (lit {span: "surf:1303..1342", type: (t-prim {} string)} "gapped pillars break the precondition")))))
