(module {}
  hello.tests.nautilus.hypothesis
  (import {}
    hello.nautilus.hypothesis
    (z_score_at_mean z_p_two_sided_zero t_one_sample_at_mean z_score))
  (import {} std.test (assert_close))
  (defsig {}
    test_z_score_at_mean_zero
    (t-fn {eff: (effects {} test)} (t-prim {} unit)))
  (def {}
    test_z_score_at_mean_zero
    (fn {}
      (params {})
      (app {span: "surf:225..330"}
        (var {span: "surf:225..237"} assert_close)
        (app {span: "surf:238..255"}
          (var {span: "surf:238..253"} z_score_at_mean))
        (cast {span: "surf:257..271"}
          (lit {span: "surf:262..265", type: (t-prim {} f32)} 0.0)
          (t-prim {} f32))
        (cast {span: "surf:273..292"}
          (lit {span: "surf:278..286", type: (t-prim {} f32)} 0.000001)
          (t-prim {} f32))
        (lit {span: "surf:294..329", type: (t-prim {} string)} "z = 0 when sample_mean = pop_mean"))))
  (defsig {}
    test_z_p_two_sided_at_zero
    (t-fn {eff: (effects {} test)} (t-prim {} unit)))
  (def {}
    test_z_p_two_sided_at_zero
    (fn {}
      (params {})
      (app {span: "surf:385..479"}
        (var {span: "surf:385..397"} assert_close)
        (app {span: "surf:398..418"}
          (var {span: "surf:398..416"} z_p_two_sided_zero))
        (cast {span: "surf:420..434"}
          (lit {span: "surf:425..428", type: (t-prim {} f32)} 1.0)
          (t-prim {} f32))
        (cast {span: "surf:436..454"}
          (lit {span: "surf:441..448", type: (t-prim {} f32)} 0.00001)
          (t-prim {} f32))
        (lit {span: "surf:456..478", type: (t-prim {} string)} "two-sided p(z=0) = 1"))))
  (defsig {}
    test_t_one_sample_at_mean_zero
    (t-fn {eff: (effects {} test)} (t-prim {} unit)))
  (def {}
    test_t_one_sample_at_mean_zero
    (fn {}
      (params {})
      (app {span: "surf:538..648"}
        (var {span: "surf:538..550"} assert_close)
        (app {span: "surf:551..573"}
          (var {span: "surf:551..571"} t_one_sample_at_mean))
        (cast {span: "surf:575..589"}
          (lit {span: "surf:580..583", type: (t-prim {} f32)} 0.0)
          (t-prim {} f32))
        (cast {span: "surf:591..610"}
          (lit {span: "surf:596..604", type: (t-prim {} f32)} 0.000001)
          (t-prim {} f32))
        (lit {span: "surf:612..647", type: (t-prim {} string)} "t = 0 when sample_mean = pop_mean"))))
  (defsig {}
    test_z_score_one_sigma
    (t-fn {eff: (effects {} test)} (t-prim {} unit)))
  (def {}
    test_z_score_one_sigma
    (fn {}
      (params {})
      (app {span: "surf:699..861"}
        (var {span: "surf:699..711"} assert_close)
        (app {span: "surf:712..788"}
          (var {span: "surf:712..719"} z_score)
          (cast {span: "surf:720..735"}
            (lit {span: "surf:725..729", type: (t-prim {} f32)} 51.0)
            (t-prim {} f32))
          (cast {span: "surf:737..752"}
            (lit {span: "surf:742..746", type: (t-prim {} f32)} 50.0)
            (t-prim {} f32))
          (cast {span: "surf:754..769"}
            (lit {span: "surf:759..763", type: (t-prim {} f32)} 10.0)
            (t-prim {} f32))
          (cast {span: "surf:771..787"}
            (lit {span: "surf:776..781", type: (t-prim {} f32)} 100.0)
            (t-prim {} f32)))
        (cast {span: "surf:790..804"}
          (lit {span: "surf:795..798", type: (t-prim {} f32)} 1.0)
          (t-prim {} f32))
        (cast {span: "surf:806..824"}
          (lit {span: "surf:811..818", type: (t-prim {} f32)} 0.00001)
          (t-prim {} f32))
        (lit {span: "surf:826..860", type: (t-prim {} string)} "z-score = 1 at one SE above mean")))))
