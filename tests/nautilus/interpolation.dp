  (defsig {}
    test_linear_at_node
    (t-fn {eff: (effects {} test)} (t-prim {} unit)))
  (def {}
    test_linear_at_node
    (fn {}
      (params {})
      (app {span: "surf:214..334"}
        (var {span: "surf:214..226"} assert_close)
        (app {span: "surf:227..258"}
          (var {span: "surf:227..242"} linear_at_query)
          (cast {span: "surf:243..257"}
            (lit {span: "surf:248..251", type: (t-prim {} f32)} 1.0)
            (t-prim {} f32)))
        (cast {span: "surf:260..274"}
          (lit {span: "surf:265..268", type: (t-prim {} f32)} 1.0)
          (t-prim {} f32))
        (cast {span: "surf:276..295"}
          (lit {span: "surf:281..289", type: (t-prim {} f32)} 0.000001)
          (t-prim {} f32))
        (lit {span: "surf:297..333", type: (t-prim {} string)} "linear interp at node = node value"))))
