(module {}
  hello.tests.nautilus.roots
  (import {} hello.nautilus.roots (sqrt2_bisect sqrt2_brent sqrt2_newton))
  (import {} std.test (assert_close))
  (defsig {} test_sqrt2_bisect (t-fn {eff: (effects {} test)} (t-prim {} unit)))
  (def {}
    test_sqrt2_bisect
    (fn {}
      (params {})
      (app {span: "surf:180..271"}
        (var {span: "surf:180..192"} assert_close)
        (app {span: "surf:193..207"} (var {span: "surf:193..205"} sqrt2_bisect))
        (cast {span: "surf:209..229"}
          (lit {span: "surf:214..223", type: (t-prim {} f32)} 1.4142135)
          (t-prim {} f32))
        (cast {span: "surf:231..249"}
          (lit {span: "surf:236..243", type: (t-prim {} f32)} 0.00001)
          (t-prim {} f32))
        (lit {span: "surf:251..270", type: (t-prim {} string)} "bisection sqrt(2)"))))
