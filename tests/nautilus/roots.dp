    (fn {}
      (params {})
      (app {span: "surf:300..370"}
        (var {span: "surf:300..312"} assert_close)
        (app {span: "surf:313..326"} (var {span: "surf:313..324"} sqrt2_brent))
        (lit {span: "surf:328..340", surf_literal_style: "explicit", type: (t-prim {} f32)} 1.4142135)
        (lit {span: "surf:342..352", surf_literal_style: "explicit", type: (t-prim {} f32)} 0.00001)
        (lit {span: "surf:354..369", type: (t-prim {} string)} "brent sqrt(2)"))))
  (defsig {span: "surf:371..488"}
    test_sqrt2_newton
    (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {span: "surf:371..488"}
    test_sqrt2_newton
    (fn {}
      (params {})
      (app {span: "surf:416..488"}
        (var {span: "surf:416..428"} assert_close)
        (app {span: "surf:429..443"} (var {span: "surf:429..441"} sqrt2_newton))
