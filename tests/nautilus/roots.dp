(module {surf_path: "Hello.Tests.Nautilus.Roots"}
  hello.tests.nautilus.roots
  (import {surf_path: "Hello.Nautilus.Roots"}
    hello.nautilus.roots
    (sqrt2_bisect sqrt2_brent sqrt2_newton))
  (import {surf_path: "Std.Test"} std.test (assert_close))
  (defsig {span: "surf:135..255"}
    test_sqrt2_bisect
    (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {span: "surf:135..255"}
    test_sqrt2_bisect
    (fn {}
      (params {})
      (app {span: "surf:180..255"}
        (var {span: "surf:180..192"} assert_close)
        (app {span: "surf:193..207"} (var {span: "surf:193..205"} sqrt2_bisect))
        (lit {span: "surf:209..221", surf_literal_style: "explicit", type: (t-prim {} f32)} 1.4142135)
        (lit {span: "surf:223..233", surf_literal_style: "explicit", type: (t-prim {} f32)} 0.00001)
        (lit {span: "surf:235..254", type: (t-prim {} string)} "bisection sqrt(2)"))))
  (defsig {span: "surf:256..370"}
    test_sqrt2_brent
    (t-fn {eff: (effects {} test)} (t-unit {})))
