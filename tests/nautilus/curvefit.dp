(module {surf_path: "Hello.Tests.Nautilus.CurveFit"}
  hello.tests.nautilus.curvefit
  (import {surf_path: "Hello.Nautilus.CurveFit"}
    hello.nautilus.curvefit
    (fit_exp_decay fit_linear_through_origin))
  (import {surf_path: "Std.Test"} std.test (assert_close))
  (defsig {span: "surf:142..291"}
    test_fit_exp_decay_recovers_half
    (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {span: "surf:142..291"}
    test_fit_exp_decay_recovers_half
    (fn {}
      (params {})
      (app {span: "surf:202..291"}
        (var {span: "surf:202..214"} assert_close)
        (app {span: "surf:215..230"}
          (var {span: "surf:215..228"} fit_exp_decay))
        (lit {span: "surf:232..238", surf_literal_style: "explicit", type: (t-prim {} f32)} 0.5)
        (lit {span: "surf:240..248", surf_literal_style: "explicit", type: (t-prim {} f32)} 0.001)
        (lit {span: "surf:250..290", type: (t-prim {} string)} "y = exp(-theta*x) recovers theta = 0.5"))))
  (defsig {span: "surf:292..442"}
    test_fit_linear_recovers_two
    (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {span: "surf:292..442"}
    test_fit_linear_recovers_two
    (fn {}
      (params {})
      (app {span: "surf:348..442"}
        (var {span: "surf:348..360"} assert_close)
        (app {span: "surf:361..388"}
          (var {span: "surf:361..386"} fit_linear_through_origin))
        (lit {span: "surf:390..396", surf_literal_style: "explicit", type: (t-prim {} f32)} 2.0)
        (lit {span: "surf:398..407", surf_literal_style: "explicit", type: (t-prim {} f32)} 0.0001)
        (lit {span: "surf:409..441", type: (t-prim {} string)} "y = theta*x recovers theta = 2")))))
