  (import {surf_path: "Std.Test"} std.test (assert_close))
  (defsig {}
    test_sample_mean_constant
    (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {}
    test_sample_mean_constant
    (fn {}
      (params {})
      (let {span: "surf:219..355"}
        (bind {}
          v
          (app {span: "surf:227..270"}
            (var {span: "surf:227..236"} to_tensor)
            (app {span: "surf:237..269"}
              (var {} Cons)
              (lit {span: "surf:238..244", surf_literal_style: "explicit", type: (t-prim {} f32)} 2.0)
              (app {}
                (var {} Cons)
                (lit {span: "surf:246..252", surf_literal_style: "explicit", type: (t-prim {} f32)} 2.0)
                (app {}
                  (var {} Cons)
                  (lit {span: "surf:254..260", surf_literal_style: "explicit", type: (t-prim {} f32)} 2.0)
                  (app {}
                    (var {} Cons)
                    (lit {span: "surf:262..268", surf_literal_style: "explicit", type: (t-prim {} f32)} 2.0)
                    (var {} Nil)))))))
        (app {span: "surf:273..353"}
          (var {span: "surf:273..285"} assert_close)
          (app {span: "surf:286..300"}
            (var {span: "surf:286..297"} sample_mean)
            (var {span: "surf:298..299"} v))
          (lit {span: "surf:302..308", surf_literal_style: "explicit", type: (t-prim {} f32)} 2.0)
          (lit {span: "surf:310..317", surf_literal_style: "explicit", type: (t-prim {} f32)} 0.000001)
          (lit {span: "surf:319..352", type: (t-prim {} string)} "mean of constant vec = constant")))))
