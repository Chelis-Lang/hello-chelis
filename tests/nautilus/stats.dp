  (defsig {}
    test_sample_mean_constant
    (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {}
    test_sample_mean_constant
    (fn {}
      (params {})
      (let {span: "surf:219..403"}
        (bind {}
          v
          (app {span: "surf:227..302"}
            (var {span: "surf:227..236"} to_tensor)
            (app {span: "surf:237..301"}
              (var {} Cons)
              (cast {span: "surf:238..252"}
                (lit {span: "surf:243..246", surf_literal_style: "unsuffixed", type: (t-prim {} f32)} 2.0)
                (t-prim {} f32))
              (app {}
                (var {} Cons)
                (cast {span: "surf:254..268"}
                  (lit {span: "surf:259..262", surf_literal_style: "unsuffixed", type: (t-prim {} f32)} 2.0)
                  (t-prim {} f32))
                (app {}
                  (var {} Cons)
                  (cast {span: "surf:270..284"}
                    (lit {span: "surf:275..278", surf_literal_style: "unsuffixed", type: (t-prim {} f32)} 2.0)
                    (t-prim {} f32))
                  (app {}
                    (var {} Cons)
                    (cast {span: "surf:286..300"}
                      (lit {span: "surf:291..294", surf_literal_style: "unsuffixed", type: (t-prim {} f32)} 2.0)
                      (t-prim {} f32))
                    (var {} Nil)))))))
        (app {span: "surf:305..401"}
          (var {span: "surf:305..317"} assert_close)
          (app {span: "surf:318..332"}
            (var {span: "surf:318..329"} sample_mean)
            (var {span: "surf:330..331"} v))
          (cast {span: "surf:334..348"}
            (lit {span: "surf:339..342", surf_literal_style: "unsuffixed", type: (t-prim {} f32)} 2.0)
            (t-prim {} f32))
          (cast {span: "surf:350..365"}
            (lit {span: "surf:355..359", surf_literal_style: "unsuffixed", type: (t-prim {} f32)} 0.000001)
            (t-prim {} f32))
          (lit {span: "surf:367..400", type: (t-prim {} string)} "mean of constant vec = constant")))))
