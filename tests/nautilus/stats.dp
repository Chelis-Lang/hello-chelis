          (cast {span: "surf:350..369"}
            (lit {span: "surf:355..363", type: (t-prim {} f32)} 0.000001)
            (t-prim {} f32))
          (lit {span: "surf:371..404", type: (t-prim {} string)} "mean of constant vec = constant")))))
