  (defsig {}
    test_sample_mean_constant
    (t-fn {eff: (effects {} test)} (t-prim {} unit)))
  (def {}
    test_sample_mean_constant
    (fn {}
      (params {})
      (let {span: "surf:219..407"}
        (bind {span: "surf:219..407"}
          v
          (app {span: "surf:227..302"}
            (var {span: "surf:227..236"} to_tensor)
            (app {span: "surf:237..301"}
              (var {} Cons)
              (cast {span: "surf:238..252"}
                (lit {span: "surf:243..246", type: (t-prim {} f32)} 2.0)
                (t-prim {} f32))
              (app {}
                (var {} Cons)
