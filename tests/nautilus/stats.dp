                    (lit {span: "surf:275..278", type: (t-prim {} f32)} 2.0)
                    (t-prim {} f32))
                  (app {}
                    (var {} Cons)
                    (cast {span: "surf:286..300"}
                      (lit {span: "surf:291..294", type: (t-prim {} f32)} 2.0)
                      (t-prim {} f32))
                    (var {} Nil)))))))
        (app {span: "surf:305..405"}
          (var {span: "surf:305..317"} assert_close)
          (app {span: "surf:318..332"}
