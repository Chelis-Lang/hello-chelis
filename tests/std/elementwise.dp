  (defsig {}
    test_sigmoid_scalar_zero
    (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {}
    test_sigmoid_scalar_zero
    (fn {}
      (params {})
      (let {span: "surf:200..288"}
        (bind {}
          result
          (app {span: "surf:213..228"}
            (var {span: "surf:213..220"} sigmoid)
            (lit {span: "surf:221..227", surf_literal_style: "explicit", type: (t-prim {} f32)} 0.0)))
        (app {span: "surf:231..286"}
          (var {span: "surf:231..243"} assert_close)
          (var {span: "surf:244..250"} result)
          (lit {span: "surf:252..258", surf_literal_style: "explicit", type: (t-prim {} f32)} 0.5)
          (lit {span: "surf:260..267", surf_literal_style: "explicit", type: (t-prim {} f32)} 0.000001)
          (lit {span: "surf:269..285", type: (t-prim {} string)} "sigmoid(0)=0.5")))))
