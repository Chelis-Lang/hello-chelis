(module {}
  hello.tests.std.decimal
  (import {} hello.std.decimal (parse_price total_cents format_total add_cents))
  (import {} std.decimal (decimal decimal_to_string decimal_eq))
  (import {} std.test (assert_eq_string assert_true))
  (defsig {}
    test_parse_and_format
    (t-fn {eff: (effects {} test)} (t-prim {} unit)))
  (def {}
    test_parse_and_format
    (fn {}
      (params {})
      (let {span: "surf:265..367"}
        (bind {span: "surf:265..367"}
          price
          (app {span: "surf:277..297"}
            (var {span: "surf:277..288"} parse_price)
            (lit {span: "surf:289..296", type: (t-prim {} string)} "19.95")))
        (app {span: "surf:300..365"}
          (var {span: "surf:300..316"} assert_eq_string)
          (app {span: "surf:317..341"}
            (var {span: "surf:317..334"} decimal_to_string)
            (var {span: "surf:335..340"} price))
          (lit {span: "surf:343..350", type: (t-prim {} string)} "19.95")
          (lit {span: "surf:352..364", type: (t-prim {} string)} "round-trip")))))
  (defsig {}
    test_total_cents_sum
    (t-fn {eff: (effects {} test)} (t-prim {} unit)))
  (def {}
    test_total_cents_sum
    (fn {}
      (params {})
      (let {span: "surf:416..644"}
        (bind {span: "surf:416..644"}
          a
          (app {span: "surf:424..439"}
            (var {span: "surf:424..431"} decimal)
            (lit {span: "surf:432..438", type: (t-prim {} string)} "1.50")))
        (let {}
          (bind {}
            b
            (app {span: "surf:446..461"}
              (var {span: "surf:446..453"} decimal)
              (lit {span: "surf:454..460", type: (t-prim {} string)} "2.25")))
          (let {}
            (bind {}
              total
              (app {span: "surf:472..489"}
                (var {span: "surf:472..483"} total_cents)
                (var {span: "surf:484..485"} a)
                (var {span: "surf:487..488"} b)))
            (let {}
              (bind {}
                __borrow_migration_out_0
                (app {span: "surf:519..587"}
                  (var {span: "surf:519..535"} assert_eq_string)
                  (app {span: "surf:536..560"}
                    (var {span: "surf:536..553"} decimal_to_string)
                    (var {span: "surf:554..559"} total))
                  (lit {span: "surf:562..568", type: (t-prim {} string)} "3.75")
                  (lit {span: "surf:570..586", type: (t-prim {} string)} "1.50+2.25=3.75")))
              (let {}
                (bind {}
                  __chelis_tmp1
                  (app {span: "surf:594..601"}
                    (var {span: "surf:594..598"} drop)
                    (var {span: "surf:599..600"} a)))
                (let {}
                  (bind {}
                    __chelis_tmp0
                    (app {span: "surf:608..615"}
                      (var {span: "surf:608..612"} drop)
                      (var {span: "surf:613..614"} b)))
                  (var {span: "surf:618..642"} __borrow_migration_out_0)))))))))
  (defsig {}
    test_format_total_with_discount
    (t-fn {eff: (effects {} test)} (t-prim {} unit)))
  (def {}
    test_format_total_with_discount
    (fn {}
      (params {})
      (let {span: "surf:704..862"}
        (bind {span: "surf:704..862"}
          subtotal
          (app {span: "surf:719..736"}
            (var {span: "surf:719..726"} decimal)
            (lit {span: "surf:727..735", type: (t-prim {} string)} "100.00")))
        (let {}
          (bind {}
            discount
            (app {span: "surf:750..766"}
              (var {span: "surf:750..757"} decimal)
              (lit {span: "surf:758..765", type: (t-prim {} string)} "15.50")))
          (let {}
            (bind {}
              out
              (app {span: "surf:775..807"}
                (var {span: "surf:775..787"} format_total)
                (var {span: "surf:788..796"} subtotal)
                (var {span: "surf:798..806"} discount)))
            (app {span: "surf:810..860"}
              (var {span: "surf:810..826"} assert_eq_string)
              (var {span: "surf:827..830"} out)
              (lit {span: "surf:832..838", type: (t-prim {} string)} "84.5")
              (lit {span: "surf:840..859", type: (t-prim {} string)} "100.00-15.50=84.5")))))))
  (defsig {} test_add_cents (t-fn {eff: (effects {} test)} (t-prim {} unit)))
  (def {}
    test_add_cents
    (fn {}
      (params {})
      (let {span: "surf:905..1044"}
        (bind {span: "surf:905..1044"}
          base
          (app {span: "surf:916..932"}
            (var {span: "surf:916..923"} decimal)
            (lit {span: "surf:924..931", type: (t-prim {} string)} "10.00")))
        (let {}
          (bind {}
            bumped
            (app {span: "surf:944..975"}
              (var {span: "surf:944..953"} add_cents)
              (var {span: "surf:954..958"} base)
              (cast {span: "surf:960..974"}
                (lit {span: "surf:965..966", type: (t-prim {} int32)} 7)
                (t-prim {} int64))))
          (app {span: "surf:978..1042"}
            (var {span: "surf:978..989"} assert_true)
            (app {span: "surf:990..1026"}
              (var {span: "surf:990..1000"} decimal_eq)
              (var {span: "surf:1001..1007"} bumped)
              (app {span: "surf:1009..1025"}
                (var {span: "surf:1009..1016"} decimal)
                (lit {span: "surf:1017..1024", type: (t-prim {} string)} "10.07")))
            (lit {span: "surf:1028..1041", type: (t-prim {} string)} "add 7 cents")))))))
