(module {}
  hello.tests.std.decimal
  (import {} hello.std.decimal (parse_price total_cents format_total add_cents))
  (import {} std.decimal (decimal decimal_to_string decimal_eq))
  (import {} std.test (assert_eq_string assert_true))
  (defsig {}
    test_parse_and_format
    (t-fn {eff: (effects {} test)} (t-prim {} unit)))
  (def {}
    test_parse_and_format
    (fn {}
      (params {})
      (let {span: "surf:265..367"}
        (bind {span: "surf:265..367"}
          price
          (app {span: "surf:277..297"}
            (var {span: "surf:277..288"} parse_price)
            (lit {span: "surf:289..296", type: (t-prim {} string)} "19.95")))
        (app {span: "surf:300..365"}
          (var {span: "surf:300..316"} assert_eq_string)
          (app {span: "surf:317..341"}
            (var {span: "surf:317..334"} decimal_to_string)
            (var {span: "surf:335..340"} price))
          (lit {span: "surf:343..350", type: (t-prim {} string)} "19.95")
          (lit {span: "surf:352..364", type: (t-prim {} string)} "round-trip")))))
  (defsig {}
    test_total_cents_sum
    (t-fn {eff: (effects {} test)} (t-prim {} unit)))
  (def {}
    test_total_cents_sum
    (fn {}
      (params {})
      (let {span: "surf:416..616"}
        (bind {span: "surf:416..616"}
          a
          (app {span: "surf:424..439"}
            (var {span: "surf:424..431"} decimal)
            (lit {span: "surf:432..438", type: (t-prim {} string)} "1.50")))
        (let {}
          (bind {}
            b
            (app {span: "surf:446..461"}
              (var {span: "surf:446..453"} decimal)
              (lit {span: "surf:454..460", type: (t-prim {} string)} "2.25")))
          (let {}
            (bind {}
              total
              (app {span: "surf:472..489"}
                (var {span: "surf:472..483"} total_cents)
                (var {span: "surf:484..485"} a)
                (var {span: "surf:487..488"} b)))
            (let {}
              (bind {}
                __borrow_migration_out_0
                (app {span: "surf:519..587"}
                  (var {span: "surf:519..535"} assert_eq_string)
                  (app {span: "surf:536..560"}
                    (var {span: "surf:536..553"} decimal_to_string)
                    (var {span: "surf:554..559"} total))
                  (lit {span: "surf:562..568", type: (t-prim {} string)} "3.75")
                  (lit {span: "surf:570..586", type: (t-prim {} string)} "1.50+2.25=3.75")))
              (var {span: "surf:590..614"} __borrow_migration_out_0)))))))
  (defsig {}
    test_format_total_with_discount
    (t-fn {eff: (effects {} test)} (t-prim {} unit)))
  (def {}
    test_format_total_with_discount
    (fn {}
      (params {})
      (let {span: "surf:676..834"}
        (bind {span: "surf:676..834"}
          subtotal
          (app {span: "surf:691..708"}
            (var {span: "surf:691..698"} decimal)
            (lit {span: "surf:699..707", type: (t-prim {} string)} "100.00")))
        (let {}
          (bind {}
            discount
            (app {span: "surf:722..738"}
              (var {span: "surf:722..729"} decimal)
              (lit {span: "surf:730..737", type: (t-prim {} string)} "15.50")))
          (let {}
            (bind {}
              out
              (app {span: "surf:747..779"}
                (var {span: "surf:747..759"} format_total)
                (var {span: "surf:760..768"} subtotal)
                (var {span: "surf:770..778"} discount)))
            (app {span: "surf:782..832"}
              (var {span: "surf:782..798"} assert_eq_string)
              (var {span: "surf:799..802"} out)
              (lit {span: "surf:804..810", type: (t-prim {} string)} "84.5")
              (lit {span: "surf:812..831", type: (t-prim {} string)} "100.00-15.50=84.5")))))))
  (defsig {} test_add_cents (t-fn {eff: (effects {} test)} (t-prim {} unit)))
  (def {}
    test_add_cents
    (fn {}
      (params {})
      (let {span: "surf:877..1016"}
        (bind {span: "surf:877..1016"}
          base
          (app {span: "surf:888..904"}
            (var {span: "surf:888..895"} decimal)
            (lit {span: "surf:896..903", type: (t-prim {} string)} "10.00")))
        (let {}
          (bind {}
            bumped
            (app {span: "surf:916..947"}
              (var {span: "surf:916..925"} add_cents)
              (var {span: "surf:926..930"} base)
              (cast {span: "surf:932..946"}
                (lit {span: "surf:937..938", type: (t-prim {} int32)} 7)
                (t-prim {} int64))))
          (app {span: "surf:950..1014"}
            (var {span: "surf:950..961"} assert_true)
            (app {span: "surf:962..998"}
              (var {span: "surf:962..972"} decimal_eq)
              (var {span: "surf:973..979"} bumped)
              (app {span: "surf:981..997"}
                (var {span: "surf:981..988"} decimal)
                (lit {span: "surf:989..996", type: (t-prim {} string)} "10.07")))
            (lit {span: "surf:1000..1013", type: (t-prim {} string)} "add 7 cents")))))))
