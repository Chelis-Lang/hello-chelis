(module {surf_path: "Hello.Tests.Std.Decimal"}
  hello.tests.std.decimal
  (import {surf_path: "Hello.Std.Decimal"}
    hello.std.decimal
    (parse_price total_cents format_total add_cents))
  (import {surf_path: "Std.Decimal"}
    std.decimal
    (decimal decimal_to_string decimal_eq))
  (import {surf_path: "Std.Test"} std.test (assert_eq_string assert_true))
  (defsig {} test_parse_and_format (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {}
    test_parse_and_format
    (fn {}
      (params {})
      (let {span: "surf:265..367"}
        (bind {}
          price
          (app {span: "surf:277..297"}
            (var {span: "surf:277..288"} parse_price)
            (lit {span: "surf:289..296", type: (t-prim {} string)} "19.95")))
        (app {span: "surf:300..365"}
          (var {span: "surf:300..316"} assert_eq_string)
          (app {span: "surf:317..341"}
            (var {span: "surf:317..334"} decimal_to_string)
            (var {span: "surf:335..340"} price))
          (lit {span: "surf:343..350", type: (t-prim {} string)} "19.95")
          (lit {span: "surf:352..364", type: (t-prim {} string)} "round-trip")))))
  (defsig {} test_total_cents_sum (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {}
    test_total_cents_sum
    (fn {}
      (params {})
      (let {span: "surf:416..562"}
        (bind {}
          a
          (app {span: "surf:424..439"}
            (var {span: "surf:424..431"} decimal)
            (lit {span: "surf:432..438", type: (t-prim {} string)} "1.50")))
        (let {}
          (bind {}
            b
            (app {span: "surf:446..461"}
              (var {span: "surf:446..453"} decimal)
              (lit {span: "surf:454..460", type: (t-prim {} string)} "2.25")))
          (let {}
            (bind {}
              total
              (app {span: "surf:472..489"}
                (var {span: "surf:472..483"} total_cents)
                (var {span: "surf:484..485"} a)
                (var {span: "surf:487..488"} b)))
            (app {span: "surf:492..560"}
              (var {span: "surf:492..508"} assert_eq_string)
              (app {span: "surf:509..533"}
                (var {span: "surf:509..526"} decimal_to_string)
                (var {span: "surf:527..532"} total))
              (lit {span: "surf:535..541", type: (t-prim {} string)} "3.75")
              (lit {span: "surf:543..559", type: (t-prim {} string)} "1.50+2.25=3.75")))))))
  (defsig {}
    test_format_total_with_discount
    (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {}
    test_format_total_with_discount
    (fn {}
      (params {})
      (let {span: "surf:622..780"}
        (bind {}
          subtotal
          (app {span: "surf:637..654"}
            (var {span: "surf:637..644"} decimal)
            (lit {span: "surf:645..653", type: (t-prim {} string)} "100.00")))
        (let {}
          (bind {}
            discount
            (app {span: "surf:668..684"}
              (var {span: "surf:668..675"} decimal)
              (lit {span: "surf:676..683", type: (t-prim {} string)} "15.50")))
          (let {}
            (bind {}
              out
              (app {span: "surf:693..725"}
                (var {span: "surf:693..705"} format_total)
                (var {span: "surf:706..714"} subtotal)
                (var {span: "surf:716..724"} discount)))
            (app {span: "surf:728..778"}
              (var {span: "surf:728..744"} assert_eq_string)
              (var {span: "surf:745..748"} out)
              (lit {span: "surf:750..756", type: (t-prim {} string)} "84.5")
              (lit {span: "surf:758..777", type: (t-prim {} string)} "100.00-15.50=84.5")))))))
  (defsig {} test_add_cents (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {}
    test_add_cents
    (fn {}
      (params {})
      (let {span: "surf:823..962"}
        (bind {}
          base
          (app {span: "surf:834..850"}
            (var {span: "surf:834..841"} decimal)
            (lit {span: "surf:842..849", type: (t-prim {} string)} "10.00")))
        (let {}
          (bind {}
            bumped
            (app {span: "surf:862..893"}
              (var {span: "surf:862..871"} add_cents)
              (var {span: "surf:872..876"} base)
              (cast {span: "surf:878..892"}
                (lit {span: "surf:883..884", surf_literal_style: "unsuffixed", type: (t-prim {} int64)} 7)
                (t-prim {} int64))))
          (app {span: "surf:896..960"}
            (var {span: "surf:896..907"} assert_true)
            (app {span: "surf:908..944"}
              (var {span: "surf:908..918"} decimal_eq)
              (var {span: "surf:919..925"} bumped)
              (app {span: "surf:927..943"}
                (var {span: "surf:927..934"} decimal)
                (lit {span: "surf:935..942", type: (t-prim {} string)} "10.07")))
            (lit {span: "surf:946..959", type: (t-prim {} string)} "add 7 cents")))))))
