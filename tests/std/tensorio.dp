          (lit {span: "surf:515..524", type: (t-prim {} string)} "default")
          (lit {span: "surf:526..552", type: (t-prim {} string)} "missing path -> fallback")))))
  (defsig {} test_save_message (t-fn {eff: (effects {} test io)} (t-unit {})))
  (def {}
    test_save_message
    (fn {}
      (params {})
      (let {span: "surf:605..743"}
        (bind {}
          out
          (app {span: "surf:615..671"}
            (var {span: "surf:615..627"} save_message)
            (lit {span: "surf:628..664", type: (t-prim {} string)} "/tmp/hello-chelis-tensorio-msg.txt")
