          (var {span: "surf:674..690"} assert_eq_string)
          (var {span: "surf:691..694"} out)
          (lit {span: "surf:696..708", type: (t-prim {} string)} "[hello] hi")
          (lit {span: "surf:710..740", type: (t-prim {} string)} "save_message persists banner"))))))
