    (write_then_read file_or_default save_message))
  (import {surf_path: "Std.Test"} std.test (assert_eq_string))
  (defsig {}
    test_write_then_read
    (t-fn {eff: (effects {} test io)} (t-unit {})))
  (def {}
    test_write_then_read
    (fn {}
      (params {})
      (let {span: "surf:194..343"}
        (bind {}
          result
          (app {span: "surf:207..276"}
            (var {span: "surf:207..222"} write_then_read)
            (lit {span: "surf:223..260", type: (t-prim {} string)} "/tmp/hello-chelis-tensorio-test.txt")
            (lit {span: "surf:262..275", type: (t-prim {} string)} "round-trip!")))
        (app {span: "surf:279..341"}
          (var {span: "surf:279..295"} assert_eq_string)
          (var {span: "surf:296..302"} result)
          (lit {span: "surf:304..317", type: (t-prim {} string)} "round-trip!")
          (lit {span: "surf:319..340", type: (t-prim {} string)} "round-trip text I/O")))))
  (defsig {}
    test_file_or_default_missing
    (t-fn {eff: (effects {} test io)} (t-unit {})))
  (def {}
    test_file_or_default_missing
    (fn {}
      (params {})
      (let {span: "surf:404..555"}
        (bind {}
          fallback
          (app {span: "surf:419..485"}
            (var {span: "surf:419..434"} file_or_default)
            (lit {span: "surf:435..473", type: (t-prim {} string)} "/tmp/hello-chelis-does-not-exist.txt")
            (lit {span: "surf:475..484", type: (t-prim {} string)} "default")))
        (app {span: "surf:488..553"}
          (var {span: "surf:488..504"} assert_eq_string)
