(module {surf_path: "Hello.Tests.Std.DatetimeCal"}
  hello.tests.std.datetimecal
  (import {surf_path: "Hello.Std.DatetimeCal"}
    hello.std.datetimecal
    (days_until format_date after_30_days week_before new_years_day))
  (import {surf_path: "Std.Time"} std.time (date))
  (import {surf_path: "Std.Test"} std.test (assert_eq))
  (defsig {} test_days_until (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {}
    test_days_until
    (fn {}
      (params {})
      (let {span: "surf:227..452"}
        (bind {}
          jan_1
          (app {span: "surf:239..288"}
            (var {span: "surf:239..243"} date)
            (cast {span: "surf:244..259"}
              (lit {span: "surf:249..253", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 2026)
              (t-prim {} i64))
            (cast {span: "surf:261..273"}
              (lit {span: "surf:266..267", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 1)
              (t-prim {} i64))
            (cast {span: "surf:275..287"}
              (lit {span: "surf:280..281", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 1)
              (t-prim {} i64))))
        (let {}
          (bind {}
            jan_31
            (app {span: "surf:300..350"}
              (var {span: "surf:300..304"} date)
              (cast {span: "surf:305..320"}
                (lit {span: "surf:310..314", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 2026)
                (t-prim {} i64))
              (cast {span: "surf:322..334"}
                (lit {span: "surf:327..328", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 1)
                (t-prim {} i64))
              (cast {span: "surf:336..349"}
                (lit {span: "surf:341..343", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 31)
                (t-prim {} i64))))
          (let {}
            (bind {}
              diff
              (app {span: "surf:360..385"}
                (var {span: "surf:360..370"} days_until)
                (var {span: "surf:371..376"} jan_1)
                (var {span: "surf:378..384"} jan_31)))
            (app {span: "surf:388..450"}
              (var {span: "surf:388..397"} assert_eq)
              (var {span: "surf:398..402"} diff)
              (cast {span: "surf:404..417"}
                (lit {span: "surf:409..411", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 30)
                (t-prim {} i64))
              (lit {span: "surf:419..449", type: (t-prim {} string)} "30 days from Jan 1 to Jan 31")))))))
  (defsig {} test_format_and_offset (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {}
    test_format_and_offset
    (fn {}
      (params {})
      (let {span: "surf:503..662"}
        (bind {}
          d
          (app {span: "surf:511..560"}
            (var {span: "surf:511..515"} date)
            (cast {span: "surf:516..531"}
              (lit {span: "surf:521..525", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 2026)
              (t-prim {} i64))
            (cast {span: "surf:533..545"}
              (lit {span: "surf:538..539", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 5)
              (t-prim {} i64))
            (cast {span: "surf:547..559"}
              (lit {span: "surf:552..553", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 7)
              (t-prim {} i64))))
        (let {}
          (bind {}
            later
            (app {span: "surf:571..587"}
              (var {span: "surf:571..584"} after_30_days)
              (var {span: "surf:585..586"} d)))
          (app {span: "surf:590..660"}
            (var {span: "surf:590..599"} assert_eq)
            (app {span: "surf:600..618"}
              (var {span: "surf:600..611"} format_date)
              (var {span: "surf:612..617"} later))
            (lit {span: "surf:620..632", type: (t-prim {} string)} "2026-06-06")
            (lit {span: "surf:634..659", type: (t-prim {} string)} "May 7 + 30 days = Jun 6"))))))
  (defsig {} test_week_before (t-fn {eff: (effects {} test)} (t-unit {})))
