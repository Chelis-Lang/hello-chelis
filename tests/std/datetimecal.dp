(module {surf_path: "Hello.Tests.Std.DatetimeCal"}
  hello.tests.std.datetimecal
  (import {surf_path: "Hello.Std.DatetimeCal"}
    hello.std.datetimecal
    (anniversary days_until format_date after_30_days week_before new_years_day))
  (import {surf_path: "Std.Datetime"} std.datetime (date))
  (import {surf_path: "Std.Test"} std.test (assert_eq))
  (defsig {span: "surf:201..413"}
    test_days_until
    (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {span: "surf:201..413"}
    test_days_until
    (fn {}
      (params {})
      (let {span: "surf:244..413"}
        (bind {}
          jan_1
          (app {span: "surf:256..281"}
            (var {span: "surf:256..260"} date)
            (lit {span: "surf:261..268", type: (t-prim {} i64)} 2026)
            (lit {span: "surf:270..274", type: (t-prim {} i64)} 1)
            (lit {span: "surf:276..280", type: (t-prim {} i64)} 1)))
        (let {}
          (bind {}
            jan_31
            (app {span: "surf:293..319"}
              (var {span: "surf:293..297"} date)
              (lit {span: "surf:298..305", type: (t-prim {} i64)} 2026)
              (lit {span: "surf:307..311", type: (t-prim {} i64)} 1)
              (lit {span: "surf:313..318", type: (t-prim {} i64)} 31)))
          (let {}
            (bind {}
              diff
              (app {span: "surf:329..354"}
                (var {span: "surf:329..339"} days_until)
                (var {span: "surf:340..345"} jan_1)
                (var {span: "surf:347..353"} jan_31)))
            (app {span: "surf:357..411"}
              (var {span: "surf:357..366"} assert_eq)
              (var {span: "surf:367..371"} diff)
              (lit {span: "surf:373..378", type: (t-prim {} i64)} 30)
              (lit {span: "surf:380..410", type: (t-prim {} string)} "30 days from Jan 1 to Jan 31")))))))
  (defsig {span: "surf:414..599"}
