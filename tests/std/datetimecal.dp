            (lit {span: "surf:477..484", type: (t-prim {} i64)} 2026)
            (lit {span: "surf:486..490", type: (t-prim {} i64)} 5)
            (lit {span: "surf:492..496", type: (t-prim {} i64)} 7)))
        (let {}
          (bind {}
            later
            (app {span: "surf:508..524"}
              (var {span: "surf:508..521"} after_30_days)
              (var {span: "surf:522..523"} d)))
          (app {span: "surf:527..597"}
            (var {span: "surf:527..536"} assert_eq)
            (app {span: "surf:537..555"}
              (var {span: "surf:537..548"} format_date)
              (var {span: "surf:549..554"} later))
            (lit {span: "surf:557..569", type: (t-prim {} string)} "2026-06-06")
            (lit {span: "surf:571..596", type: (t-prim {} string)} "May 7 + 30 days = Jun 6"))))))
  (defsig {span: "surf:600..796"}
    test_week_before
    (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {span: "surf:600..796"}
    test_week_before
    (fn {}
      (params {})
      (let {span: "surf:644..796"}
