                (t-prim {} int64))
              (cast {span: "surf:368..383"}
                (lit {span: "surf:373..375", surf_literal_style: "unsuffixed", type: (t-prim {} int64)} 31)
                (t-prim {} int64))))
          (let {}
            (bind {}
              diff
