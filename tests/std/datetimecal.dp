              (var {span: "surf:328..332"} date)
              (cast {span: "surf:333..350"}
                (lit {span: "surf:338..342", surf_literal_style: "unsuffixed", type: (t-prim {} int64)} 2026)
                (t-prim {} int64))
              (cast {span: "surf:352..366"}
