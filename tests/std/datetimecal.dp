              (lit {span: "surf:938..942", type: (t-prim {} i64)} 1)))
          (lit {span: "surf:946..958", type: (t-prim {} string)} "2025-02-28")
          (lit {span: "surf:960..989", type: (t-prim {} string)} "anniversary clamps leap day"))))))
