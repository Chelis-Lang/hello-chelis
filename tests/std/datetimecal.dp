(module {surf_path: "Hello.Tests.Std.DatetimeCal"}
  hello.tests.std.datetimecal
  (import {surf_path: "Hello.Std.DatetimeCal"}
    hello.std.datetimecal
    (days_until format_date after_30_days week_before new_years_day))
  (import {surf_path: "Std.Time"} std.time (date))
  (import {surf_path: "Std.Test"} std.test (assert_eq_int assert_eq_string))
  (defsig {} test_days_until (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {}
    test_days_until
    (fn {}
      (params {})
      (let {span: "surf:249..478"}
        (bind {}
          jan_1
          (app {span: "surf:261..310"}
            (var {span: "surf:261..265"} date)
            (cast {span: "surf:266..281"}
              (lit {span: "surf:271..275", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 2026)
              (t-prim {} i64))
            (cast {span: "surf:283..295"}
              (lit {span: "surf:288..289", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 1)
              (t-prim {} i64))
            (cast {span: "surf:297..309"}
              (lit {span: "surf:302..303", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 1)
              (t-prim {} i64))))
        (let {}
          (bind {}
            jan_31
            (app {span: "surf:322..372"}
              (var {span: "surf:322..326"} date)
              (cast {span: "surf:327..342"}
                (lit {span: "surf:332..336", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 2026)
                (t-prim {} i64))
              (cast {span: "surf:344..356"}
                (lit {span: "surf:349..350", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 1)
                (t-prim {} i64))
              (cast {span: "surf:358..371"}
                (lit {span: "surf:363..365", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 31)
                (t-prim {} i64))))
          (let {}
            (bind {}
              diff
              (app {span: "surf:382..407"}
                (var {span: "surf:382..392"} days_until)
                (var {span: "surf:393..398"} jan_1)
                (var {span: "surf:400..406"} jan_31)))
            (app {span: "surf:410..476"}
              (var {span: "surf:410..423"} assert_eq_int)
              (var {span: "surf:424..428"} diff)
              (cast {span: "surf:430..443"}
                (lit {span: "surf:435..437", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 30)
                (t-prim {} i64))
              (lit {span: "surf:445..475", type: (t-prim {} string)} "30 days from Jan 1 to Jan 31")))))))
  (defsig {} test_format_and_offset (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {}
    test_format_and_offset
    (fn {}
      (params {})
      (let {span: "surf:529..695"}
        (bind {}
          d
          (app {span: "surf:537..586"}
            (var {span: "surf:537..541"} date)
            (cast {span: "surf:542..557"}
              (lit {span: "surf:547..551", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 2026)
              (t-prim {} i64))
            (cast {span: "surf:559..571"}
              (lit {span: "surf:564..565", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 5)
              (t-prim {} i64))
            (cast {span: "surf:573..585"}
              (lit {span: "surf:578..579", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 7)
              (t-prim {} i64))))
        (let {}
          (bind {}
            later
            (app {span: "surf:597..613"}
              (var {span: "surf:597..610"} after_30_days)
              (var {span: "surf:611..612"} d)))
          (app {span: "surf:616..693"}
            (var {span: "surf:616..632"} assert_eq_string)
            (app {span: "surf:633..651"}
              (var {span: "surf:633..644"} format_date)
              (var {span: "surf:645..650"} later))
            (lit {span: "surf:653..665", type: (t-prim {} string)} "2026-06-06")
            (lit {span: "surf:667..692", type: (t-prim {} string)} "May 7 + 30 days = Jun 6"))))))
  (defsig {} test_week_before (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {}
    test_week_before
    (fn {}
      (params {})
      (let {span: "surf:740..907"}
        (bind {}
          d
          (app {span: "surf:748..778"}
            (var {span: "surf:748..761"} new_years_day)
            (cast {span: "surf:762..777"}
              (lit {span: "surf:767..771", surf_literal_style: "unsuffixed", type: (t-prim {} i64)} 2026)
              (t-prim {} i64))))
        (let {}
          (bind {}
            earlier
            (app {span: "surf:791..805"}
              (var {span: "surf:791..802"} week_before)
              (var {span: "surf:803..804"} d)))
          (app {span: "surf:808..905"}
            (var {span: "surf:808..824"} assert_eq_string)
            (app {span: "surf:825..845"}
              (var {span: "surf:825..836"} format_date)
              (var {span: "surf:837..844"} earlier))
            (lit {span: "surf:847..859", type: (t-prim {} string)} "2025-12-25")
            (lit {span: "surf:861..904", type: (t-prim {} string)} "7 days before Jan 1, 2026 is Dec 25, 2025")))))))
