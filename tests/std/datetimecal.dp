            (lit {span: "surf:750..793", type: (t-prim {} string)} "7 days before Jan 1, 2026 is Dec 25, 2025"))))))
  (defsig {span: "surf:797..992"}
    test_anniversary_leap_day
    (t-fn {eff: (effects {} test)} (t-unit {})))
  (def {span: "surf:797..992"}
    test_anniversary_leap_day
    (fn {}
      (params {})
      (let {span: "surf:850..992"}
        (bind {}
          leap_day
