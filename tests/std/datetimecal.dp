                (var {span: "surf:405..410"} jan_1)
                (var {span: "surf:412..418"} jan_31)))
            (app {span: "surf:422..490"}
              (var {span: "surf:422..435"} assert_eq_int)
              (var {span: "surf:436..440"} diff)
              (cast {span: "surf:442..457"}
                (lit {span: "surf:447..449", surf_literal_style: "unsuffixed", type: (t-prim {} int64)} 30)
                (t-prim {} int64))
              (lit {span: "surf:459..489", type: (t-prim {} string)} "30 days from Jan 1 to Jan 31")))))))
  (defsig {} test_format_and_offset (t-fn {eff: (effects {} test)} (t-unit {})))
