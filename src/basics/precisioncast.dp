(module {surf_path: "Hello.Basics.PrecisionCast"}
  hello.basics.precisioncast
  (export {}
    to_f64_scalar
    to_f32_scalar
    round_scalar
    to_f64
    to_f32
    low_then_high)
  (defsig {} to_f64_scalar (t-fn {} (t-prim {} f32) (t-prim {} f64)))
  (def {}
    to_f64_scalar
    (fn {}
      (params {} (x {type: (t-var {} _)}))
      (cast {span: "surf:152..164"}
        (var {span: "surf:157..158"} x)
        (t-prim {} f64))))
  (defsig {} to_f32_scalar (t-fn {} (t-prim {} f64) (t-prim {} f32)))
  (def {}
    to_f32_scalar
    (fn {}
      (params {} (x {type: (t-var {} _)}))
      (cast {span: "surf:200..212"}
        (var {span: "surf:205..206"} x)
        (t-prim {} f32))))
  (defsig {} round_scalar (t-fn {} (t-prim {} f32) (t-prim {} f32)))
  (def {}
    round_scalar
    (fn {}
      (params {} (x {type: (t-var {} _)}))
      (pipe {span: "surf:247..282"}
        (var {span: "surf:247..248"} x)
        (var {span: "surf:252..265"} to_f64_scalar)
        (var {span: "surf:269..282"} to_f32_scalar))))
  (defsig {}
    to_f64
    (n)
    (t-fn {}
      (t-tensor {} (d-var {} n) (t-prim {} f32))
      (t-tensor {} (d-var {} n) (t-prim {} f64))))
  (def {}
    to_f64
    (fn {}
      (params {} (x {type: (t-var {} _)}))
      (cast {span: "surf:336..348"}
        (var {span: "surf:341..342"} x)
        (t-prim {} f64))))
  (defsig {}
    to_f32
    (n)
    (t-fn {}
      (t-tensor {} (d-var {} n) (t-prim {} f64))
      (t-tensor {} (d-var {} n) (t-prim {} f32))))
  (def {}
    to_f32
    (fn {}
      (params {} (x {type: (t-var {} _)}))
      (cast {span: "surf:402..414"}
        (var {span: "surf:407..408"} x)
        (t-prim {} f32))))
  (defsig {}
    low_then_high
    (n)
    (t-fn {}
      (t-tensor {} (d-var {} n) (t-prim {} f32))
      (t-tensor {} (d-var {} n) (t-prim {} f32))))
  (def {}
    low_then_high
    (fn {}
      (params {} (x {type: (t-var {} _)}))
      (pipe {span: "surf:475..496"}
        (var {span: "surf:475..476"} x)
        (var {span: "surf:480..486"} to_f64)
        (var {span: "surf:490..496"} to_f32)))))
